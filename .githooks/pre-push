#!/bin/sh
# pre-push — gridlock's local push gate. GENERATED by the hub's
# scripts/build-shared.mjs from scripts/lib/game-pre-push.sh: edit it there.
#
# Runs, before anything reaches origin/main:
#   1. this repo's own scripts/ci.sh, when it has one
#   2. the hub's per-game checkers scoped to this game
#      (connectthethoughts/scripts/game-gate.mjs), from the hub checkout beside
#      this one — a session worktree set's own hub, or the main hub
# Nothing runs remotely: Actions is off arcade-wide, so this IS the gate.
# A Vite game still needs its build published after the push:
#   node <hub>/scripts/deploy-vite.mjs gridlock   (arcade-worktree --ship does it)
#
# Hatch: ARCADE_SKIP_CI=1 git push … — say why.

# Only a push that updates main is a release of this game. deploy-vite.mjs
# pushes gh-pages, which must not re-run the whole gate.
gates=0
while read -r _lref _lsha rref _rsha; do
  case "$rref" in refs/heads/main|refs/heads/master) gates=1 ;; esac
done
[ "$gates" = 1 ] || exit 0

if [ "${ARCADE_SKIP_CI:-}" = "1" ]; then
  echo "pre-push: ARCADE_SKIP_CI=1 — local gates SKIPPED for gridlock" >&2
  exit 0
fi

# git exports GIT_DIR and friends into hooks, and they override `-C <path>` in
# every nested git call the checkers make.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_COMMON_DIR
root=$(git rev-parse --show-toplevel 2>/dev/null)
[ -n "$root" ] || root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root" || exit 1

if [ -f scripts/ci.sh ]; then
  echo "pre-push: gridlock scripts/ci.sh"
  bash scripts/ci.sh || { echo "pre-push: scripts/ci.sh FAILED — push refused." >&2; exit 1; }
fi

parent=$(dirname "$root")
gate="$parent/connectthethoughts/scripts/game-gate.mjs"
if [ "$(basename "$root")" = "gridlock" ] && [ -f "$gate" ]; then
  echo "pre-push: hub per-game checkers (game-gate.mjs gridlock)"
  ARCADE_ROOT="$parent" node "$gate" gridlock \
    || { echo "pre-push: the hub's per-game checkers FAILED — push refused." >&2; exit 1; }
else
  echo "pre-push: WARNING — no hub checkout at $parent/connectthethoughts (or this checkout is not named gridlock); the hub's per-game checkers did NOT run." >&2
fi
exit 0
